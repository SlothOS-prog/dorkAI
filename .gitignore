# ============================================================
# .gitignore для проекта dorkAI
# Всё перечисленное ниже НЕ попадает в репозиторий.
# ============================================================

# --- Секреты ---------------------------------------------------
# Файл с API-ключом: НИКОГДА не публикуем (утечка ключа = чужие списания)
.env
*.local

# --- Сборка PyInstaller ----------------------------------------
# Временные папки сборщика и сам exe: их можно пересобрать в любой момент
build/
dist/
release/
*.spec
# но если хотите хранить готовый exe в репозитории — удалите строку "*.spec"
# или добавьте исключение: !dorkAI.spec

# --- Кэш Python -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# --- Виртуальные окружения ------------------------------------
venv/
.venv/
env/

# --- IDE / редакторы ------------------------------------------
.idea/
.vscode/
*.swp

# --- Системные файлы Windows ----------------------------------
Thumbs.db
Desktop.ini
