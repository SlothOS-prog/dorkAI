# ============================================================
# dorkAI — example environment file.
# Copy this file as ".env" and fill in your key, OR simply
# paste it via the "API key" button inside the app — dorkAI
# will create the .env file for you automatically.
# ============================================================

# API key for any OpenAI-compatible provider.
# Examples: gsk_... (Groq), sk-or-... (OpenRouter), sk-... (OpenAI)
DORKAI_API_KEY=

# Provider base URL. Default: Groq — the fastest free tier today.
DORKAI_BASE_URL=https://api.groq.com/openai/v1

# Model name (fast + capable Groq model).
DORKAI_MODEL=llama-3.3-70b-versatile

# Per-request timeout in seconds.
DORKAI_TIMEOUT=30

# Maximum number of dorks requested from the model per generation.
DORKAI_MAX_DORKS=10

# Ask the provider to return strict JSON (1 = yes, 0 = no).
DORKAI_JSON_MODE=1
