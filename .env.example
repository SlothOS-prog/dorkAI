# ============================================================
# dorkAI — файл с примером переменных окружения.
# Скопируйте этот файл под именем ".env" и впишите свой ключ,
# ЛИБО просто вставьте ключ через кнопку "API-ключ" в программе
# (программа сама создаст .env за вас).
# ============================================================

# Ключ доступа к ИИ-провайдеру (формат OpenAI-совместимого API).
# Пример: gsk_... (Groq), sk-or-... (OpenRouter), sk-... (OpenAI)
DORKAI_API_KEY=

# Базовый URL провайдера (по умолчанию Groq — самый быстрый бесплатный вариант)
DORKAI_BASE_URL=https://api.groq.com/openai/v1

# Название модели (быстрая и качественная модель Groq)
DORKAI_MODEL=llama-3.3-70b-versatile

# Таймаут одного запроса к ИИ, секунды
DORKAI_TIMEOUT=30

# Максимум дорков, который просим сгенерировать ИИ
DORKAI_MAX_DORKS=10

# Просить ли провайдер возвращать строгий JSON (1 = да, 0 = нет)
DORKAI_JSON_MODE=1
